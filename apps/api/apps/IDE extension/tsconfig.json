{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "out",
    "rootDir": "../../../..",
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "extension.ts",
    "webview.tsx",
    "../../../src/**/*.ts",
    "../../../src/**/*.tsx"
  ],
  "exclude": ["node_modules", "out", "dist", "build"]
}
