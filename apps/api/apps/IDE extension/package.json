{
  "name": "vertico",
  "displayName": "Vertico",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Code Analysis"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vertico.startChat",
        "title": "Start Vertico"
      },
      {
        "command": "Vertico.reviewFile",
        "title": "Review File"
      },
      {
        "command": "vertico.refactorFile",
        "title": "Refactor File"
      },
      {
        "command": "Vertico.fixbug",
        "title": "Fix Bug"
      },
      {
        "command": "copilot.indexRepo",
        "title": "Index Repository"
      },
      {
        "command": "copilot.acceptDiff",
        "title": "Copilot: Accept Changes"
      },
      {
        "command": "copilot.rejectDiff",
        "title": "Copilot: Reject Changes"
      }
    ],
    "keybindings": [
      {
        "command": "vertico.startChat",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      },
      {
        "command": "vertico.refactorFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "configuration": {
      "title": "Vertico",
      "properties": {
        "Vertico.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000/api",
          "description": "URL of the Vertico API"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "vertico.refactorFile",
          "group": "copilot"
        },
        {
          "command": "Vertico.fixbug",
          "group": "copilot"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ../../../../tsconfig.json",
    "dev": "tsc -watch -p ../../../../tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
