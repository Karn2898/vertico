{
    "name": "Vertico",
    "displayName": "Vertico",
    "version": "0.1.0",
    "engines":{"vscode":"^1.85.0"},
    "categories":["Machine Learning","Programming Languages","Code Analysis"],
    "activationEvents":["onStartupFinished"],
    "main": "./out/extension.js",
    "ontributes":{
        "commands":[
            {
                "command":"vertico.start",
                "title":"Start Vertico"
            },
            {
                "command":"vertico.reviewFile",
                "title":"Review File"
            },
            {
                "command":"vertico.refactorCode",
                "title":"Refactor Code"
            },
            {
                "command":"vertico.fixbug",
                "title": "fix bug",

            },
            {
        "command": "copilot.acceptDiff",
        "title": "Copilot: Accept Changes"
      },
      {
        "command": "copilot.rejectDiff",
        "title": "Copilot: Reject Changes"
      }

        ],

        "keybindings":[
            {
                "command":"vertico.start",
                "key":"ctrl+shift+v",
                "mac":"cmd+shift+v",
            },
            {
                "command":"copilot.refactorFile",
                "key":"ctrl+shift+r",
                "mac":"cmd+shift+r",
            }
        ],
        "configuration":{
            "title":Vertico ",
            "properties":{
            "type":"string",
            "default": "http://localhost:8000",
          "description": "URL of the Copilot Agent API"
        }
    }
},
"menus": {
      "editor/context": [
        {
          "command": "copilot.refactorFile",
          "group": "copilot"
        },
        {
          "command": "copilot.fixBug",
          "group": "copilot"
        }
      ]
    }
  },
  "scripts":{
    "build":"tsc -p tsconfig.json && cd webview && vite build",
    "dev": "tsc -watch -p tsconfig.json",
    "webview:dev":"cd webview && vite"
  },
  "devDependencies":{
     "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}