{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "out",
    "rootDir": "../../../..",
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "extension.ts",
    "../../../src/chat/**/*.ts",
    "../../../src/services/**/*.ts",
    "../../../src/session/**/*.ts",
    "../../../src/diff/**/*.ts",
    "../../../src/context/**/*.ts",
    "../../../src/api/**/*.ts"
  ],
  "exclude": ["node_modules", "out", "dist", "build", "src/components"]
}
